@push('js')
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
    // Counter animation
    var txCounted = false;
    new IntersectionObserver(function(entries, obs){
        if(!entries[0].isIntersecting || txCounted) return;
        txCounted = true;
        document.querySelectorAll('.tx-count').forEach(function(el){
            var target = +el.dataset.target, start = null;
            function step(ts){
                if(!start) start = ts;
                var p = Math.min((ts - start) / 2000, 1);
                el.textContent = Math.floor(p * target);
                if(p < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
        });
        obs.disconnect();
    }, {threshold:.3}).observe(document.querySelector('.tx-counter'));

    // "Who we are" video popup
    (function(){
        var modal = document.getElementById('txVideo'), btn = document.querySelector('.tx-play');
        if(!btn) return;
        btn.addEventListener('click', function(e){
            e.preventDefault();
            if(!modal) return;
            var src = btn.dataset.video;
            modal.querySelector('iframe').src = src + (src.indexOf('?') > -1 ? '&' : '?') + 'autoplay=1';
            modal.classList.add('open');
        });
        if(!modal) return;
        modal.addEventListener('click', function(e){
            if(e.target === modal || e.target.closest('.tx-search-close')){
                modal.classList.remove('open');
                modal.querySelector('iframe').src = '';
            }
        });
    })();

    // Sliders
    // Hero slider (only when the admin has more than one slide)
    if (document.querySelectorAll('.tx-hero-slide').length > 1) {
        new Swiper('.tx-hero-slider', {
            effect: 'fade', fadeEffect: {crossFade: true},
            loop: true, speed: 900,
            autoplay: {delay: 6000, disableOnInteraction: false},
            pagination: {el: '.tx-hero-dots', clickable: true}
        });
    }

    // Services slider: 4 cards on desktop, auto-slides one card at a time
    var txServiceLoop = document.querySelectorAll('.tx-service-slider .swiper-slide').length > 4;
    new Swiper('.tx-service-slider', {
        loop:txServiceLoop, rewind:!txServiceLoop, spaceBetween:24, speed:700,
        autoplay:{delay:3500, disableOnInteraction:false, pauseOnMouseEnter:true},
        slidesPerView:1,
        breakpoints:{576:{slidesPerView:2}, 992:{slidesPerView:3}, 1200:{slidesPerView:4}},
        navigation:{prevEl:'.tx-service-prev', nextEl:'.tx-service-next'}
    });

    // Case studies: 3 full cards on desktop, auto-slides one at a time.
    // Loop needs at least slidesPerView + 1 slides, otherwise a gap shows on the right.
    var txCaseLoop = document.querySelectorAll('.tx-case-slider .swiper-slide').length > 3;
    new Swiper('.tx-case-slider', {
        loop:txCaseLoop, rewind:!txCaseLoop, spaceBetween:20, speed:700,
        autoplay:{delay:4000, disableOnInteraction:false, pauseOnMouseEnter:true},
        slidesPerView:1,
        breakpoints:{768:{slidesPerView:2}, 1200:{slidesPerView:3}},
        pagination:{el:'.tx-case-dots', clickable:true}
    });
    new Swiper('.tx-testi-slider', {
        loop:true, spaceBetween:40, speed:700,
        autoplay:{delay:5000, disableOnInteraction:false},
        slidesPerView:1,
        breakpoints:{992:{slidesPerView:2}},
        pagination:{el:'.tx-testi-dots', clickable:true}
    });
</script>
@endpush
