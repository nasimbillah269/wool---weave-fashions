<!-- ================= Hero (Admin > Sliders > "Front Page Slider") ================= -->
@php
    // Each active slide with a "Slide Name" becomes a hero slide:
    // Sub Title = small text above the heading, Slide Name = heading, Description = paragraph,
    // Button Text/Link = button, Slide Image = background photo.
    $txHeroTag = 'Technology Related Consultancy'; // used when a slide has no Sub Title
    $txHeroSlides = collect();
    if ($txSlider = slider('Front Page Slider')) {
        foreach ($txSlider->subSliders as $slide) {
            if (!trim((string) $slide->name)) continue;
            $link = trim((string) $slide->seo_description);
            $txHeroSlides->push([
                'tag'     => trim((string) $slide->short_description) ?: $txHeroTag,
                'title'   => $slide->name,
                'text'    => trim(strip_tags((string) $slide->description)),
                'btnText' => $slide->seo_title,
                'btnLink' => $link === '' ? '#services' : (preg_match('~^(https?:|#|mailto:|tel:)~i', $link) ? $link : url($link)),
                'image'   => $slide->imageFile ? asset($slide->image()) : null,
            ]);
        }
    }
    // Default hero when no slide has been set up yet
    if ($txHeroSlides->isEmpty()) {
        $txHeroSlides->push([
            'tag'     => $txHeroTag,
            'title'   => "We transform ideas\ninto technology",
            'text'    => 'We provide the most responsive and functional IT design for companies and businesses worldwide.',
            'btnText' => 'Read More',
            'btnLink' => '#services',
            'image'   => null,
        ]);
    }
@endphp
